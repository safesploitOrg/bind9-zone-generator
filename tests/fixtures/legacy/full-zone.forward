$TTL 300
@   IN  SOA ns1.example.com. hostmaster.example.com. (
        2026050512 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        86400 )    ; minimum

    IN  NS  ns1.example.com.

; ================================
; Generated BIND9 Records
; Primary hostname = A record
; Additional names = CNAME records
; ================================

app                              IN       A        192.0.2.10
www                              IN       CNAME    app

ns1                              IN       A        192.0.2.53
