$TTL 300
@   IN  SOA ns1.example.com. hostmaster.example.com. (
        2026050512 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        86400 )    ; minimum

    IN  NS  ns1.example.com.

; ================================
; Generated PTR Records
; Reverse Zone: 2.0.192.in-addr.arpa
; ================================

10       IN       PTR      app.example.com.
20       IN       PTR      shared.example.com.
